<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080817">
  <title>Notifications | IGEE ARENA</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    .notifications-page {
      width: min(900px, 92%);
      margin: 35px auto;
    }
    .notification-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin: 24px 0;
    }
    .notification-list {
      display: grid;
      gap: 14px;
    }
    .notification-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px;
      border: 1px solid rgba(150, 110, 255, .22);
      border-radius: 14px;
      background: rgba(255, 255, 255, .035);
    }
    .notification-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(139, 92, 246, .15);
      font-size: 21px;
    }
    .notification-content {
      flex: 1;
    }
    .notification-content h3 {
      margin: 0 0 6px;
      font-size: 15px;
    }
    .notification-content p {
      margin: 0 0 8px;
      opacity: .8;
      font-size: 13px;
      line-height: 1.6;
    }
    .notification-time {
      font-size: 11px;
      opacity: .55;
    }
    .unread-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #a78bfa;
      flex-shrink: 0;
      margin-top: 6px;
    }
    .notification-tabs {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }
    .notification-tabs button,
    .notification-action {
      padding: 9px 14px;
      border: 1px solid rgba(150, 110, 255, .3);
      border-radius: 9px;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    .notification-tabs button.active {
      background: #7138df;
      border-color: #7138df;
      color: white;
    }
    .notification-empty {
      padding: 35px 15px;
      text-align: center;
      opacity: .7;
    }
    @media (max-width: 500px) {
      .notification-item { padding: 13px; }
      .notification-icon { width: 38px; height: 38px; }
    }
  </style>
</head>
<body>
  <main class="notifications-page">
    <a href="dashboard.html">← Back to Dashboard</a>

    <header style="margin-top:25px">
      <p style="color:#a78bfa;font-weight:bold">YOUR ACTIVITY</p>
      <h1>Notifications</h1>
      <p>Stay updated with everything happening in IGEE ARENA.</p>
    </header>

    <section class="notification-toolbar">
      <div class="notification-tabs">
        <button class="active" data-filter="all">All</button>
        <button data-filter="unread">Unread</button>
      </div>
      <button class="notification-action" id="markAllRead">
        Mark all as read
      </button>
    </section>

    <section class="notification-list" id="notificationList">
      <div class="notification-empty">
        <h2>You're all caught up!</h2>
        <p>Your notifications will appear here when available.</p>
      </div>
    </section>

    <p style="margin-top:25px;font-size:12px;opacity:.6">
      Notifications shown here are currently a frontend preview.
      Live notifications will be connected to the IGEE ARENA backend.
    </p>
  </main>

  <script>
    const filterButtons = document.querySelectorAll("[data-filter]");
    const markAllRead = document.getElementById("markAllRead");
    const notificationList = document.getElementById("notificationList");

    let activeFilter = "all";
    let notifications = [];

    function renderNotifications() {
      const filtered = notifications.filter(item =>
        activeFilter === "all" || !item.read
      );

      if (!filtered.length) {
        notificationList.innerHTML = `
          <div class="notification-empty">
            <h2>You're all caught up!</h2>
            <p>No notifications to display.</p>
          </div>
        `;
        return;
      }

      notificationList.innerHTML = filtered.map(item => `
        <article class="notification-item">
          <div class="notification-icon">${item.icon}</div>
          <div class="notification-content">
            <h3>${item.title}</h3>
            <p>${item.message}</p>
            <span class="notification-time">${item.time}</span>
          </div>
          ${item.read ? "" : '<span class="unread-dot"></span>'}
        </article>
      `).join("");
    }

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.filter;

        filterButtons.forEach(tab =>
          tab.classList.toggle("active", tab === button)
        );

        renderNotifications();
      });
    });

    markAllRead.addEventListener("click", () => {
      notifications = notifications.map(item => ({
        ...item,
        read: true
      }));
      renderNotifications();
    });
  </script>
</body>
</html>
